# ---- Game data: never commit (user supplies their own discs) ----
/roms/
/extracted/
*.7z
*.zip
*.bin
*.cue
*.iso
*.chd

# ---- Generated from the game (regenerated locally) ----
/analysis/out/
/analysis/__pycache__/
__pycache__/

# ---- Third-party tools (fetched by INSTALL.bat) ----
/tools/

# ---- Generated by build/splat (derived from game bytes) ----
/build/
/asm/
/undefined_*_auto.txt

# ---- Sandbox harness: generated per run (real paths, staged exe, results) ----
/recomp/sandbox/_*

# ---- Player files (PLAY.bat): settings, memory cards/savestates, run dir ----
/settings.ini
/saves/
/play/
/PLAY.exe

# ---- Dev scratch / superseded (kept locally, not published) ----
/analysis/cc/
/recomp/rt/
/RECOMP_NOTES_ps1recomp.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
